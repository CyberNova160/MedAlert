# Supabase: create a project at https://supabase.com and run supabase/schema.sql
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: webhook called when a new SOS is submitted (e.g. your notification service)
NOTIFICATION_WEBHOOK_URL=

# Optional admin dashboard access key. Set a long random value before public deployment.
ADMIN_ACCESS_KEY=
